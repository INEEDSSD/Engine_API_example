.0);\n inputs.metallic = metaParam;\n inputs.specular = 0.5;\n inputs.specularColor = vec3(1.0,1.0,1.0);\nfloat flo_6 = 1.0;\n inputs.smoothness = flo_6;\nfloat flo_23 = 0.5;\n inputs.occlusion = flo_23;\n inputs.alpha = 1.0;\n\n        Surface surface;\n            initSurface(surface, inputs);\n            PixelInfo info;\ngetPixelInfo(info, pixel, surface);\n            vec4 surfaceColor = SurfaceShading(surface, info);\nfinalColor = surfaceColor;\n\n        \tgl_FragColor = finalColor;\n        }\r\n#endGLSL\r\n#defineGLSL VS1\r\n#include \"Color.glsl\";\n        #include \"Scene.glsl\";\n        #include \"Camera.glsl\";\n        #include \"Sprite3DVertex.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintVertex.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintPixelVertex.glsl\";\n        void main()\n        {\n            Vertex vertex;\n            getVertexParams(vertex);\n        \tPixelParams pixel;\n            initPixelParams(pixel, vertex);\n        \n            varyingPixelParams(pixel);\n            gl_Position = getPositionCS(pixel.positionWS);\n            gl_Position = remapPositionZ(gl_Position);\n        \n            gl_Position = vec4(a_Texcoord1 * 2.0 - 1.0, 0.0, 1.0);\n            \n\n        }\n            \r\n#endGLSL\r\n#defineGLSL FS1\r\n#include \"Color.glsl\";\n        #include \"Scene.glsl\";\n        #include \"Camera.glsl\";\n        #include \"Sprite3DFrag.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintPixelFrag.glsl\";\n        #include \"shaderBlueprint/lightmode/BlueprintPBRMetal.glsl\";\nvoid main()\n        {\n            PixelParams pixel;\n            getPixelParams(pixel);\n        \tvec4 finalColor = vec4(0.0, 0.0, 0.0, 1.0);\n        SurfaceInputs inputs;\n inputs.normalTS = vec3(0.0,0.0,1.0);\n inputs.baseColor = vec3(1.0,1.0,1.0);\n inputs.metallic = metaParam;\n inputs.specular = 0.5;\n inputs.specularColor = vec3(1.0,1.0,1.0);\nfloat flo_6 = 1.0;\n inputs.smoothness = flo_6;\nfloat flo_23 = 0.5;\n inputs.occlusion = flo_23;\n inputs.alpha = 1.0;\n\n        \nSurface surface;\ninitSurface(surface, inputs);\n\nPixelInfo info;\ngetPixelInfo(info, pixel, surface);\n\nvec4 surfaceColor = vec4(1.0, 0.0, 1.0, 1.0);\n\n#ifdef METAALBEDO\n#ifdef TRANSPANENT\nsurfaceColor = vec4(inputs.baseColor, surface.alpha);\n#else // \nsurfaceColor = vec4(inputs.baseColor, 1.0);\n#endif // TRANSPANENT\n#endif // METAALBEDO\n\n#ifdef METANORMAIL\nvec3 normal = inputs.normalTS;\nnormal.y *=-1.0;\nnormal =normalize(normal);\nsurfaceColor = vec4((normal + 1.0) * 0.5, 1.0);\n#endif // METANORMAIL\n\n#ifdef METAEMISSION\n#ifdef EMISSION\nsurfaceColor = vec4(surface.emissionColor.rgb, 1.0);\n#else // EMISSION\nsurfaceColor = vec4(vec3(0.0), 1.0);\n#endif // EMISSION\n#endif // METAEMISSION\n\n#ifdef METAEMETALLIC\nsurfaceColor = vec4(vec3(inputs.metallic), 1.0);\n#endif // METAEMETALLIC\n\n#ifdef METAEROUNGNESS\nsurfaceColor = vec4(vec3(surface.perceptualRoughness), 1.0);\n#endif // METAEROUNGNESS\n\nfinalColor = surfaceColor;\n\n        \tgl_FragColor = finalColor;\n        }\r\n#endGLSL\r\n#defineGLSL VS2\r\n#include \"Color.glsl\";\n        #include \"Scene.glsl\";\n        #include \"Camera.glsl\";\n        #include \"Sprite3DVertex.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintVertex.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintPixelVertex.glsl\";\n        void main()\n        {\n            Vertex vertex;\n            getVertexParams(vertex);\n        \tPixelParams pixel;\n            initPixelParams(pixel, vertex);\n        \n            varyingPixelParams(pixel);\n            gl_Position = getPositionCS(pixel.positionWS);\n            gl_Position = remapPositionZ(gl_Position);\n        \n        }\n            \r\n#endGLSL\r\n#defineGLSL FS2\r\n#include \"Color.glsl\";\n        #include \"Scene.glsl\";\n        #include \"Camera.glsl\";\n        #include \"Sprite3DFrag.glsl\";\n        #include \"shaderBlueprint/lib/BlueprintPixelFrag.glsl\";\n        \n        void main()\n        {\n            PixelParams pixel;\n            getPixelParams(pixel);\n        \tvec4 finalColor = vec4(pixel.positionWS, 1.0);\n        \tgl_FragColor = finalColor;\n        }\r\n#endGLSL\r\nGLSL End\r\n","version":1718868307882}