    "laya.gltf": true,
    "laya.physics": true,
    "laya.physics3D": true,
    "laya.physics3D.wasm": false,
    "laya.blueprint": true,
    "laya.legacyParser": true,
    "laya.tiledmap_discarded": true,
    "laya.trailCommon": true,
    "laya.trail3D": true,
    "laya.postProcess": true,
    "laya.particle3D": true,
    "laya.navMesh": true,
    "laya.device": true,
    "laya.ui": true,
    "laya.ani": true,
    "laya.navMesh2D": true,
    "laya.spine": true,
    "laya.physics2D": true,
    "laya.tilemap": true,
    "laya.trail2D": true,
    "laya.particle": true,
    "laya.line2D": true,
    "laya.light2D": true
