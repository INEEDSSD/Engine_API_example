{
  "resolution": {
    "designWidth": 1334,
    "screenMode": "horizontal",
    "backgroundColor": "rgba(0, 0, 0, 1)"
  },
  "2D": {
    "useRetinalCanvas": true,
    "isAlpha": true
  },
